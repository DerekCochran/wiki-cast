|-
! Afrikaans
! Dutch
! English
|-
| {{lang|af|het}}
| {{lang|nl|heb, hebt, heeft, hebben}}
| have, has
|-
| {{lang|af|die}}
| {{lang|nl|de, het}}
| the
|-
| {{lang|af|dit}}
| {{lang|nl|het}}
| it
|}

