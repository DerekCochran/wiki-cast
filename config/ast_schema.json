{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wikitext AST Schema",
  "description": "Schema for the token tree generated by the Wikitext parser.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "root",
        "heading",
        "template",
        "magic-word",
        "redirect",
        "comment",
        "ext",
        "include",
        "html",
        "td",
        "dunder",
        "quote",
        "image-parameter",
        "ext-link",
        "imagemap-link",
        "parameter",
        "arg",
        "converter",
        "converter-flags",
        "attributes",
        "atom",
        "syntax",
        "onlyinclude",
        "param-line",
        "list-range",
        "list",
        "dd",
        "text"
      ]
    },
    "childNodes": {
      "type": "array",
      "items": { "$ref": "#" }
    }
  },
  "required": ["type"],
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "text" } } },
      "then": { "properties": { "data": { "type": "string" } }, "required": ["data"] }
    },
    {
      "if": { "properties": { "type": { "const": "heading" } } },
      "then": {
        "properties": {
          "childNodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "template" } } },
      "then": { "properties": { "name": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "magic-word" } } },
      "then": { "properties": { "name": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "redirect" } } },
      "then": {
        "properties": {
          "pre": { "type": "string" },
          "post": { "type": "string" },
          "link": { "type": "string" },
          "display": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "ext" } } },
      "then": {
        "properties": {
          "name": { "type": "string" },
          "attr": { "type": "string" },
          "inner": { "type": "string" },
          "closing": { "type": "string" },
          "self_closing": { "type": "boolean" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "include" } } },
      "then": {
        "properties": {
          "tag": { "type": "string" },
          "attr": { "type": "string" },
          "inner": { "type": "string" },
          "closing": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "html" } } },
      "then": {
        "properties": {
          "self_closing": { "type": "boolean" },
          "orig_tag": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "td" } } },
      "then": { "properties": { "inner_syntax": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "dunder" } } },
      "then": {
        "properties": {
          "case_sensitive": { "type": "boolean" },
          "fullwidth": { "type": "boolean" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "parameter" } } },
      "then": { "properties": { "name": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "arg" } } },
      "then": { "properties": { "name": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "converter" } } },
      "then": {
        "properties": {
          "variant": { "type": "string" },
          "unidirectional": { "type": "boolean" },
          "bidirectional": { "type": "boolean" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "converter-flags" } } },
      "then": { "properties": { "flags": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "attributes" } } },
      "then": {
        "properties": {
          "name": { "type": "string" },
          "className": { "type": "string" },
          "id": { "type": "string" },
          "sanitized": { "type": "boolean" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "atom" } } },
      "then": { "properties": { "type": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "syntax" } } },
      "then": { "properties": { "type": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "onlyinclude" } } },
      "then": { "properties": { "innerText": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "param-line" } } },
      "then": { "properties": { "name": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "list-range" } } },
      "then": {
        "properties": {
          "previousSibling": { "type": "number" },
          "nextSibling": { "type": "number" },
          "previousElementSibling": { "type": "number" },
          "nextElementSibling": { "type": "number" }
        }
      }
    }
  ]
}