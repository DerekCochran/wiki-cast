{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wiki-cast.local/schema/wiki-cast.json",
  "title": "wiki-cast internal AST contract",
  "description": "Unified recursive token contract generated by token_to_json(). All children are tokens (including text tokens).",
  "$ref": "#/definitions/token",
  "definitions": {
    "nodeType": {
      "type": "string",
      "enum": [
        "root",
        "redirect",
        "redirect-syntax",
        "redirect-target",
        "comment",
        "ext",
        "noinclude",
        "include",
        "includeonly",
        "onlyinclude",
        "translate",
        "arg",
        "arg-name",
        "arg-default",
        "template",
        "template-name",
        "magic-word",
        "magic-word-name",
        "parameter",
        "parameter-key",
        "parameter-value",
        "heading",
        "heading-title",
        "heading-trail",
        "html",
        "html-attrs",
        "html-attr",
        "html-attr-dirty",
        "table",
        "tr",
        "td",
        "table-syntax",
        "table-attrs",
        "table-attr",
        "table-attr-dirty",
        "table-inter",
        "table-inner",
        "td-inner",
        "hr",
        "double-underscore",
        "link",
        "file",
        "category",
        "text",
        "link-target",
        "link-text",
        "quote",
        "ext-link",
        "ext-link-url",
        "ext-link-text",
        "magic-link",
        "free-ext-link",
        "list",
        "dd",
        "converter",
        "converter-rule",
        "converter-rule-from",
        "converter-rule-variant",
        "converter-rule-to",
        "converter-flags",
        "converter-flag",
        "attributes",
        "attr-equal-tmp",
        "attr-key",
        "attr-value",
        "atom",
        "hidden",
        "ext-attrs",
        "ext-inner",
        "ext-attr-dirty",
        "ext-attr",
        "image-parameter",
        "gallery-image",
        "imagemap-image",
        "gallery-line",
        "gallery-param-wrapper",
        "imagemap-link-inner",
        "imagemap-image-line",
        "imagemap-link",
        "invoke-module",
        "invoke-function",
        "param-line"
      ]
    },
    "token": {
      "type": "object",
      "required": [
        "type", "Type", "SubType"
      ],
      "properties": {
        "type": {
          "$ref": "#/definitions/nodeType"
        },
        "Type": {
          "type": "string"
        },
        "SubType": {
          "type": "string"
        },
        "tokenType": {
          "type": "integer"
        },
        "tokenSubtype": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "childCount": {
          "type": "integer",
          "minimum": 0
        },
        "childCap": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "type": "integer"
        },
        "include": {
          "type": "boolean"
        },
        "built": {
          "type": "boolean"
        },
        "extInnerContext": {
          "type": "boolean"
        },
        "sepCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "sep": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "text": {
          "type": "string"
        },
        "textLen": {
          "type": "integer",
          "minimum": 0
        },
        "textOwned": {
          "type": "boolean"
        },
        "level": {
          "type": "integer"
        },
        "closed": {
          "type": "boolean"
        },
        "selfClosing": {
          "type": "boolean"
        },
        "closing": {
          "type": "boolean"
        },
        "origTag": {
          "type": "string"
        },
        "origTagLen": {
          "type": "integer",
          "minimum": 0
        },
        "innerSyntax": {
          "type": "string"
        },
        "innerSyntaxLen": {
          "type": "integer",
          "minimum": 0
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "fullwidth": {
          "type": "boolean"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "pre": {
          "type": "string"
        },
        "preLen": {
          "type": "integer",
          "minimum": 0
        },
        "post": {
          "type": "string"
        },
        "postLen": {
          "type": "integer",
          "minimum": 0
        },
        "link": {
          "type": "string"
        },
        "linkLen": {
          "type": "integer",
          "minimum": 0
        },
        "display": {
          "type": "string"
        },
        "displayLen": {
          "type": "integer",
          "minimum": 0
        },
        "extName": {
          "type": "string"
        },
        "extNameLen": {
          "type": "integer",
          "minimum": 0
        },
        "extAttr": {
          "type": "string"
        },
        "extAttrLen": {
          "type": "integer",
          "minimum": 0
        },
        "extInner": {
          "type": "string"
        },
        "extInnerLen": {
          "type": "integer",
          "minimum": 0
        },
        "extClosing": {
          "type": "string"
        },
        "extClosingLen": {
          "type": "integer",
          "minimum": 0
        },
        "extSelfClosing": {
          "type": "boolean"
        },
        "tag": {
          "type": "string"
        },
        "tagLen": {
          "type": "integer",
          "minimum": 0
        },
        "includeAttr": {
          "type": "string"
        },
        "includeAttrLen": {
          "type": "integer",
          "minimum": 0
        },
        "includeInner": {
          "type": "string"
        },
        "includeInnerLen": {
          "type": "integer",
          "minimum": 0
        },
        "includeClosing": {
          "type": "string"
        },
        "includeClosingLen": {
          "type": "integer",
          "minimum": 0
        },
        "equal": {
          "type": "string"
        },
        "equalLen": {
          "type": "integer",
          "minimum": 0
        },
        "quoteOpenCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "quoteCloseCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "quoteOpen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "quoteClose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "rawSyntax": {
          "type": "string"
        },
        "rawSyntaxLen": {
          "type": "integer",
          "minimum": 0
        },
        "space": {
          "type": "string"
        },
        "spaceLen": {
          "type": "integer",
          "minimum": 0
        },
        "magicPipe": {
          "type": "boolean"
        },
        "modifier": {
          "type": "string"
        },
        "modifierLen": {
          "type": "integer",
          "minimum": 0
        },
        "childNodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/token"
          }
        }
      },
      "additionalProperties": false
    }
  }
}